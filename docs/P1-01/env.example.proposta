# PROPOSTA de .env.example do Dash — SÓ NOMES DE CHAVE, sem valores.
# Fonte: nomes lidos pelo CÓDIGO (getenv/$_ENV/$_SERVER/process.env) — o .env de
# produção NÃO foi aberto. Lista possivelmente incompleta: chaves montadas
# dinamicamente (ex.: "DB_{$label}_HOST") só aparecem pelos rótulos encontrados.
APP_ENV=
LOG_LEVEL=
DSHOWDASH_URL=
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_LIFETIME=
SESSION_COOKIE_SAMESITE=
HEALTH_ALLOWED_IPS=
# bancos (padrão DB_<ROTULO>_{HOST,PORT,NAME,USER,PASS})
DB_DSHOWDASH_HOST=
DB_DSHOWDASH_PORT=
DB_DSHOWDASH_NAME=
DB_DSHOWDASH_USER=
DB_DSHOWDASH_PASS=
DB_DSHOW_PROD_HOST=
DB_DSHOW_PROD_PORT=
DB_DSHOW_PROD_NAME=
DB_DSHOW_PROD_USER=
DB_DSHOW_PROD_PASS=
DB_ADS_DSHOW_NAME=
DB_ADS_DSHOW_USER=
# chaves de cifra por integração
PIPEDRIVE_CRYPTO_KEY=
BLING_CRYPTO_KEY=
GCAL_CRYPTO_KEY=
OUTLOOK_CRYPTO_KEY=
ADS_CRYPTO_KEY=
DATATABLES_CRYPTO_KEY=
# Pipedrive
PIPEDRIVE_WEBHOOK_USER=
PIPEDRIVE_WEBHOOK_PASS=
# Bling
BLING_PROVIDER=
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=
BLING_WEBHOOK_SECRET=
# Google Calendar
GCAL_PROVIDER=
GCAL_OAUTH_STAGE=
GCAL_WEBHOOK_URL=
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# Microsoft / Outlook
OUTLOOK_PROVIDER=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=
MS_OAUTH_TENANT=
MS_OAUTH_SCOPES=
# Google Ads / Analytics
ADS_PROVIDER=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GA_PROVIDER=
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_JSON=
# Trânsito
TRAFFIC_PROVIDER=
TOMTOM_TRAFFIC_API_KEY=
# Ponte do app / avatar
AVST_PONTE_SEGREDO_ARQUIVO=
# Infra (ferramentas)
HOSTINGER_VM_ID=
HOSTINGER_API_TOKEN=
SCREENSHOT_SERVICE_USER=
