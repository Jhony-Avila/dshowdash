{
  "module": "carousel",
  "version": "4.1.0-ENTERPRISE-COMPLETE",
  "description": "Sistema de carrossel enterprise com lazy-loading, telemetria e orquestração",
  "architecture": "modular-with-slides",
  "dependencies": [
    "Chart.js"
  ],
  "events": {
    "emits": [
      "carousel:ready",
      "carousel:slideChange",
      "carousel:play",
      "carousel:pause",
      "carousel:mount",
      "carousel:unmount",
      "carousel:loadSlide",
      "carousel:error"
    ],
    "listens": [
      "header:refresh:request",
      "header:refresh:done",
      "data:refresh",
      "visibilitychange"
    ]
  },
  "api": {
    "public": [
      "mount(options)",
      "unmount()",
      "new DashboardCarousel(options) // multi-instância"
    ],
    "instance": [
      "start()",
      "stop()",
      "pause()",
      "resume()",
      "next()",
      "prev()",
      "goTo(index)",
      "getStatus()"
    ]
  },
  "features": [
    "Lazy-loading de slides",
    "Look-ahead/behind preload",
    "ARIA completa + keyboard navigation",
    "Telemetria estruturada",
    "Orquestração com app lifecycle",
    "Pause on hover",
    "Reduced motion support",
    "Focus management",
    "CSS FOUC prevention",
    "Multi-instância opcional"
  ],
  "improvements": {
    "v4.1.0": [
      "P0: Integração com EventBus/contracts",
      "P0: Orquestração (visibilitychange, header events)",
      "P0: Seletores escopados",
      "P1: Focus management",
      "P1: Telemetria estruturada",
      "P1: Look-ahead/behind preload",
      "P1: CSS loading com onload",
      "P2: Cleanup enxuto (só AbortController)",
      "P2: Suporte multi-instância"
    ]
  }
}
