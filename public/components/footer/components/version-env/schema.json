{
  "name": "footer-version-env",
  "version": "1.0.0",
  "description": "Componente autocontido do Footer responsável por exibir versão e ambiente",
  "lifecycle": {
    "mount": true,
    "update": true,
    "destroy": true
  },
  "inputs": {
    "props": {
      "required": ["version", "environment"],
      "optional": ["locale"]
    },
    "dependencies": {
      "globalState": true,
      "eventBus": false,
      "orchestrator": false,
      "telemetry": true
    }
  },
  "outputs": {
    "events": [],
    "telemetry": {
      "namespace": "footer.version-env",
      "events": ["mounted", "destroyed"]
    }
  },
  "ui": {
    "providesMarkup": true,
    "providesStyles": true,
    "rootClass": "footer-version-env",
    "accessible": true
  },
  "behavior": {
    "idempotent": true,
    "reentrant": true,
    "faultTolerant": true,
    "asyncSafe": true
  }
}
