{
  "id": "footer",
  "version": "9.2.0-ENTERPRISE",
  "name": "Footer System",
  "description": "Enterprise Footer Component - 2 Faixas, Dock, Lottie, Premium UI",
  "author": "DshowDash Team",
  "layout": {
    "type": "two-bar",
    "topBarHeight": "80px",
    "bottomBarHeight": "36px"
  },
  "brand": {
    "name": "DshowDash",
    "tagline": "Enterprise Business Intelligence",
    "animation": {
      "enabled": true,
      "path": "/components/animacoes/Lottie_Graph_Growth.json",
      "autoplay": true,
      "loop": true,
      "speed": 0.8,
      "respectReducedMotion": true
    }
  },
  "dock": {
    "enabled": true,
    "showTooltips": true,
    "items": [
      { "id": "docs", "icon": "docs", "tooltip": "Documentação", "href": "/docs", "ariaLabel": "Acessar documentação" },
      { "id": "support", "icon": "support", "tooltip": "Suporte", "href": "/support", "ariaLabel": "Acessar suporte técnico" },
      { "id": "status", "icon": "status", "tooltip": "Status", "href": "/status", "ariaLabel": "Ver status do sistema" },
      { "id": "sep1", "type": "separator" },
      { "id": "settings", "icon": "settings", "tooltip": "Configurações", "href": "/settings", "ariaLabel": "Configurações do sistema" },
      { "id": "server", "icon": "server", "tooltip": "Servidores", "href": "/servers", "ariaLabel": "Monitoramento de servidores" },
      { "id": "database", "icon": "database", "tooltip": "Banco de Dados", "href": "/database", "ariaLabel": "Gerenciar banco de dados" },
      { "id": "sep2", "type": "separator" },
      { "id": "api", "icon": "api", "tooltip": "APIs", "href": "/api", "ariaLabel": "Monitorar APIs" },
      { "id": "pipedrive", "icon": "pipedrive", "tooltip": "Pipedrive", "href": "/pipedrive", "ariaLabel": "Integração Pipedrive" },
      { "id": "financial", "icon": "financial", "tooltip": "Financeiro", "href": "/financial", "ariaLabel": "Módulo financeiro" }
    ]
  },
  "quickStatus": {
    "connection": { "enabled": true },
    "session": { "enabled": true },
    "orchestrator": { "enabled": true },
    "lastUpdate": { "enabled": true },
    "language": { "enabled": true },
    "geo": { "enabled": true },
    "devices": { "enabled": true },
    "mode": { "enabled": true }
  },
  "bottomBar": {
    "copyright": {
      "company": "Display Solutions",
      "text": "Todos os direitos reservados."
    },
    "meta": {
      "showBuild": true,
      "showLastUpdate": true,
      "showNode": true,
      "nodeName": "srv920234"
    },
    "legal": {
      "enabled": true,
      "links": [
        { "label": "Termos de Uso", "href": "/terms" },
        { "label": "Privacidade", "href": "/privacy" },
        { "label": "LGPD", "href": "/lgpd" }
      ]
    }
  },
  "components": {
    "brand": { "enabled": true, "order": 1 },
    "dock": { "enabled": true, "order": 2 },
    "quick-status": { "enabled": true, "order": 3 },
    "status-mode": { "enabled": true, "order": 4 },
    "status-devices": { "enabled": true, "order": 5 },
    "status-lang": { "enabled": true, "order": 6 },
    "status-geo": { "enabled": true, "order": 7 },
    "copyright": { "enabled": true, "order": 8 },
    "meta": { "enabled": true, "order": 9 },
    "legal": { "enabled": true, "order": 10 },
    "announce-live-region": { "enabled": true, "order": 11 }
  },
  "features": {
    "routerIntegration": true,
    "globalStateIntegration": true,
    "eventBusIntegration": true,
    "appShellIntegration": true,
    "telemetryEnabled": true,
    "circuitBreakerEnabled": true,
    "lottieEnabled": true
  },
  "defaults": {
    "locale": "pt-BR",
    "environment": "production",
    "debug": false,
    "containerSelector": "#footer-root"
  },
  "i18n": {
    "brandName": "DshowDash",
    "usefulLinks": "Links Úteis",
    "systemStatus": "Status do Sistema",
    "documentation": "Documentação",
    "support": "Suporte",
    "status": "Status",
    "connection": "Conexão",
    "online": "Online",
    "offline": "Offline",
    "lastUpdate": "Atualizado",
    "session": "Sessão",
    "orchestrator": "Orchestrator",
    "language": "Idioma",
    "geo": "Localização",
    "devices": "Dispositivos",
    "mode": "Modo",
    "copyright": "Display Solutions. Todos os direitos reservados.",
    "connectionRestored": "Conexão restaurada",
    "connectionLost": "Conexão perdida",
    "footerLabel": "Rodapé do sistema",
    "accessDocumentation": "Acessar documentação",
    "accessSupport": "Acessar suporte técnico",
    "viewStatus": "Ver status do sistema",
    "systemVersion": "Versão do sistema",
    "environment": "Ambiente",
    "currentPage": "Página atual"
  }
}
