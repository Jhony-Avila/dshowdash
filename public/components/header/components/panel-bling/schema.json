{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "panel-bling",
  "version": "8.1.0-ENTERPRISE",
  "title": "Bling Component",
  "description": "Header trigger component for Bling integration panel",
  "type": "header-trigger",
  "category": "integration",
  "enterprise": true,
  "capabilities": {
    "reorderable": true,
    "hideable": true,
    "critical": false,
    "refreshable": false,
    "configurable": true
  },
  "config": {
    "icon": "/assets/icons/system/header/bling.svg",
    "label": "Bling",
    "panelId": "bling-panel",
    "event": "panel:bling:open"
  },
  "state": {
    "type": "object",
    "properties": {
      "isActive": { "type": "boolean", "default": false },
      "lastClick": { "type": ["number", "null"], "default": null }
    }
  },
  "events": {
    "emits": ["component:mounted", "component:unmounted", "component:error", "ui:action"],
    "listens": []
  },
  "dependencies": [],
  "telemetry": {
    "trackMounts": true,
    "trackClicks": true,
    "trackErrors": true
  }
}
