{
  "module": "login-modal",
  "version": "5.2.0-ENTERPRISE",
  "description": "Modal de Login Enterprise-Grade - Autocontido e Modular",
  "zIndex": 400,
  "idPrefix": "login",

  "security": {
    "rateLimitAttempts": 5,
    "rateLimitWindow": 300000,
    "lockoutDuration": 900000,
    "maxUsernameLength": 128,
    "maxPasswordLength": 256,
    "minPasswordLength": 4,
    "passwordTrim": false,
    "usernameEmailValidation": true,
    "secureMode": true
  },

  "api": {
    "timeout": 10000,
    "maxRetries": 1,
    "retryableStatuses": [500, 502, 503, 504],
    "endpoints": {
      "login": "/api/auth/login.php",
      "check": "/api/auth/check.php",
      "logout": "/api/auth/logout.php"
    }
  },

  "video": {
    "src": "/assets/videos/video_background_site_web.mp4",
    "preload": "none",
    "cleanupOnClose": true,
    "fallbackClass": "video-fallback",
    "loadTimeout": 5000,
    "autoplayRetries": 2
  },

  "accessibility": {
    "focusTrapEnabled": true,
    "escapeToClose": true,
    "escapeBlockedWhenBusy": true,
    "ariaDescribedByEnabled": true,
    "ariaLiveEnabled": true,
    "focusFirstElementDelay": 100,
    "focusVisibilityPolicy": "offsetParent"
  },

  "telemetry": {
    "enabled": true,
    "namespace": "auth",
    "rateLimit": 100,
    "samplingRate": 1.0,
    "batchEnabled": false,
    "batchSize": 10,
    "events": [
      "auth:modal:opened",
      "auth:modal:closed",
      "auth:login:attempt",
      "auth:login:success",
      "auth:login:error",
      "auth:rate:limited",
      "auth:session:expired",
      "auth:video:loaded",
      "auth:video:error",
      "auth:video:fallback"
    ],
    "includeTimestamp": true,
    "includeLatency": true
  },

  "animation": {
    "transitionDuration": 300,
    "reducedMotion": true,
    "fadeOutDuration": 400
  },

  "ui": {
    "errorDisplayDuration": 5000,
    "countdownEnabled": true,
    "clearFormOnSuccess": true,
    "clearFormOnError": false,
    "focusOnError": true,
    "busyButtonText": "Autenticando...",
    "labels": {
      "submitIdle": "Entrar",
      "submitBusy": "Entrando...",
      "passwordShow": "Mostrar senha",
      "passwordHide": "Ocultar senha"
    }
  },

  "storage": {
    "namespace": "dshowdash:login",
    "persistRateLimit": true,
    "sessionStorageEnabled": true
  },

  "debug": {
    "enabled": false,
    "logLevel": "warn",
    "jsonMode": false,
    "silent": true,
    "logTimers": false,
    "logAborts": false,
    "logValidation": false
  },

  "governance": {
    "id": "login-modal",
    "type": "modal",
    "critical": true,
    "singleton": true,
    "category": "auth"
  },

  "compatibility": {
    "minVersion": "5.0.0",
    "browserSupport": ["Chrome >= 90", "Firefox >= 88", "Safari >= 14", "Edge >= 90"]
  }
}
