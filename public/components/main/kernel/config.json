{
  "version": "1.1.0",
  "kernel": {
    "logLevel": "info",
    "enableConsoleCommands": true,
    "enableHealthMonitor": true,
    "enableCircuitBreaker": true,
    "healthMonitorIntervalMs": 30000,
    "healthMonitorAutoRecover": true,
    "featureEnableTimeoutMs": 5000,
    "circuitBreakerFailureThreshold": 5,
    "circuitBreakerTimeout": 30000
  },
  "logging": {
    "defaultLevel": "info",
    "modules": {
      "lazy-loader": "info",
      "circuit-breaker": "warn",
      "health-monitor": "info",
      "hot-reload": "info",
      "config-loader": "info",
      "persistence-sync": "info",
      "components-self-healing": "warn",
      "panel-home-manager": "info"
    },
    "levels": {
      "debug": 0,
      "info": 1,
      "warn": 2,
      "error": 3,
      "none": 99
    }
  },
  "features": {
    "error-boundary": {
      "enabled": true,
      "priority": 0,
      "maxErrorHistory": 100,
      "errorRateWindowMs": 60000
    },
    "observability-hooks": {
      "enabled": true,
      "priority": 0
    },
    "navigation-hooks": {
      "enabled": true,
      "priority": 0
    },
    "persistence-sync": {
      "enabled": true,
      "priority": 0,
      "syncDebounceMs": 500,
      "maxHistorySize": 20
    },
    "ux-feedback": {
      "enabled": true,
      "priority": 1
    },
    "analytics-tracker": {
      "enabled": true,
      "priority": 1
    },
    "preload-manager": {
      "enabled": true,
      "priority": 1
    },
    "session-sync": {
      "enabled": true,
      "priority": 1
    }
  }
}
