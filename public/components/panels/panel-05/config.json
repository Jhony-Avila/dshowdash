{
  "id": "panel-05",
  "name": "Clientes 360º",
  "description": "Gestão estratégica de clientes e relacionamentos com visão completa",
  "category": "crm",
  "refreshInterval": 60000,
  "enabled": true,
  "version": "8.1.0-ENTERPRISE",
  "architecture": "autocontained",
  "author": "DShow Dashboard",
  "created": "2025-11-08",
  "updated": "2025-12-18",
  "dependencies": [],
  "permissions": ["read", "export"],
  "features": [
    "autocontained",
    "idempotent",
    "resilient",
    "observable",
    "scalable",
    "self-healing",
    "dark-mode",
    "export-csv",
    "keyboard-shortcuts"
  ],
  "telemetry": {
    "enabled": true,
    "events": [
      "lifecycle:mounted",
      "lifecycle:unmounted",
      "data:loaded",
      "data:error",
      "mode:degraded",
      "export:completed",
      "theme:changed"
    ]
  }
}
