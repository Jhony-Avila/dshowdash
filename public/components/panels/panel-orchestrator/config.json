{
  "id": "panel-orchestrator",
  "name": "Core Application Orchestrator",
  "version": "1.0.0",
  "type": "orchestrator",
  "critical": true,
  "description": "Central coordinator for all panels, presets, and application lifecycle",
  "author": "DshowDash Team",
  "dependencies": [],
  "features": {
    "presets": true,
    "scheduler": true,
    "apiGateway": true,
    "healthMonitor": true,
    "degradeMode": true,
    "telemetry": true
  },
  "defaults": {
    "preset": "default",
    "schedulerMode": "ACTIVE",
    "healthCheckInterval": 30000,
    "maxRetries": 3,
    "circuitBreakerThreshold": 5
  },
  "telemetry": {
    "namespace": "orchestrator",
    "events": [
      "orchestrator:init",
      "orchestrator:ready",
      "orchestrator:preset:applied",
      "orchestrator:layout:changed",
      "orchestrator:degraded",
      "orchestrator:recovered",
      "orchestrator:module:registered",
      "orchestrator:module:failed"
    ]
  }
}
