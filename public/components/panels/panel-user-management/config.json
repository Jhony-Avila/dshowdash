{
  "id": "panel-user-management",
  "name": "Gestão de Usuários",
  "version": "3.0.0-ENTERPRISE",
  "description": "Painel de administração de usuários, roles e sessões",
  "category": "admin",
  "icon": "👥",
  "status": "stable",
  "priority": 1,
  "permissions": {
    "required": ["users:view"],
    "optional": ["users:edit", "users:create", "users:delete", "users:manage-roles", "users:reset-password", "sessions:terminate"]
  },
  "dependencies": {
    "core": ["PermissionsGuard", "SecurityPolicies", "SessionManager", "GlobalState", "EventBus"],
    "optional": ["TelemetryCore", "Toast", "NotificationManager"]
  },
  "api": {
    "baseUrl": "/api/admin/users",
    "endpoints": ["list", "get", "update", "reset-password", "roles", "assign-role", "user-sessions", "terminate-session"]
  },
  "features": {
    "userList": true,
    "userDetails": true,
    "userEdit": true,
    "roleManagement": true,
    "sessionManagement": true,
    "passwordReset": true,
    "search": true,
    "filters": true,
    "pagination": false,
    "export": false
  },
  "telemetry": {
    "enabled": true,
    "events": [
      "init:start", "init:complete", "init:error",
      "mounted", "unmounted",
      "load:start", "load:success", "load:error",
      "user:selected", "user:updated", "user:created",
      "role:changed", "password:reset", "session:terminated",
      "filter:changed", "pagination:changed",
      "access:denied", "auth:required"
    ]
  },
  "ui": {
    "layout": "grid",
    "skeleton": true,
    "emptyState": true,
    "errorState": true,
    "responsive": true
  },
  "routes": {
    "main": "panel-user-management",
    "aliases": ["users", "user-management", "admin-users"]
  },
  "audit": {
    "sensitiveActions": ["user:updated", "role:changed", "password:reset", "session:terminated"],
    "requireConfirmation": ["password:reset", "session:terminated", "user:deactivate"]
  }
}
