{
  "name": "panel-user-preferences",
  "version": "4.0.0-ENTERPRISE",
  "description": "Painel de preferências do usuário - tema, notificações, layouts, views",
  "author": "DshowDash Team",
  "created": "2024-12-01",
  "updated": "2024-12-18",
  "status": "active",
  "architecture": "modular-enterprise",
  "dependencies": {
    "internal": [
      "/core/auth/adapters/auth-adapter-enterprise.js",
      "/app/events/events-contracts.js"
    ],
    "global": ["EventBus", "Toast", "LoginModal", "LoggerGlobal", "TelemetryCore"]
  },
  "exports": ["mount", "unmount", "refresh", "getStatus", "healthCheck", "info"],
  "cssPrefix": "pup-",
  "features": [
    "theme-switching",
    "density-control", 
    "notifications-toggle",
    "layouts-management",
    "saved-views",
    "export-import",
    "history-timeline",
    "drag-drop-reorder",
    "keyboard-shortcuts",
    "undo-stack",
    "push-notifications"
  ]
}
