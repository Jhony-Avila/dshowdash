{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Health Contract v2",
  "version": "2.0.0",
  "description": "Contrato de health check para módulos runtime",
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["HEALTHY", "DEGRADED", "UNHEALTHY"] },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "moduleId": { "type": "string" },
    "version": { "type": "string" },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "severity": { "type": "string", "enum": ["info", "warn", "crit"] }
        },
        "required": ["ok", "severity"]
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["code", "severity", "message"]
      }
    },
    "metrics": { "type": "object" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["status", "score", "moduleId", "version", "timestamp"]
}
