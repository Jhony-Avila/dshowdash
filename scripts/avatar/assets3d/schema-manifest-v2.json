{
  "$comment": "Manifest §517 v2 — onda 1406 (MEGA_BRIEFING_01 §2576–§2590, decisão #157). Formato PRÓPRIO e mínimo (sem lib): `campos` = nome → {tipo, enum?, obrigatorio?, desde?}. Regras: campo obrigatório ausente = ERRO; campo conhecido com tipo/enum errado = ERRO; campo DESCONHECIDO = AVISO (§2583); campos marcados `premium` são obrigatórios só a partir de qualidadeVisual ≥ premium (§2589). v1 (sem schemaVersion) continua válido: só os campos v1 são obrigatórios.",
  "versao": 2,
  "campos": {
    "id": { "tipo": "string", "obrigatorio": true },
    "tipo": { "tipo": "string", "obrigatorio": true, "enum": ["personagem_base", "parte_cabelo", "parte_barba", "parte_roupa", "parte_acessorio", "cenario", "vfx", "pet", "companion"] },
    "versao": { "tipo": "number", "obrigatorio": true },
    "rig": { "tipo": "string", "obrigatorio": true },
    "lods": { "tipo": "object", "obrigatorio": true },
    "hashes": { "tipo": "object", "obrigatorio": true },
    "triangulos": { "tipo": "object" },
    "animacoes": { "tipo": "array" },
    "licenca": { "tipo": "object", "obrigatorio": true },
    "origem": { "tipo": "string", "obrigatorio": true },
    "fonte_original": { "tipo": "string" },
    "criado_em": { "tipo": "string" },
    "mascara": { "tipo": "array" },
    "familia": { "tipo": "string", "enum": ["economico", "padrao", "premium"] },
    "excecoes": { "tipo": "object" },

    "schemaVersion": { "tipo": "number", "desde": 2 },
    "qualidadeVisual": { "tipo": "string", "desde": 2, "enum": ["prototype", "legacy", "production", "premium", "hero"] },
    "qaVisual": { "tipo": "object", "desde": 2, "premium": true },
    "artBibleVersion": { "tipo": "string", "desde": 2, "premium": true },
    "visibility": { "tipo": "string", "desde": 2, "enum": ["internal", "dev", "production", "hero"] },
    "deprecated": { "tipo": "boolean", "desde": 2 },
    "successorId": { "tipo": "string", "desde": 2, "nulo": true },
    "renderers": { "tipo": "array", "desde": 2 },
    "bounds": { "tipo": "object", "desde": 2, "premium": true },
    "pivot": { "tipo": "string", "desde": 2 },
    "eixos": { "tipo": "string", "desde": 2 },
    "escalaMetros": { "tipo": "number", "desde": 2 },
    "materiais": { "tipo": "object", "desde": 2, "premium": true },
    "corpo": { "tipo": "object", "desde": 2 },
    "morphs": { "tipo": "object", "desde": 2 },
    "socket": { "tipo": "string", "desde": 2 },
    "ancora": { "tipo": "object", "desde": 2 },
    "classe": { "tipo": "string", "desde": 2, "enum": ["base", "rosto", "cabelo", "roupa", "small", "medium", "hero", "pet", "companion", "cenario"] },
    "hairMask": { "tipo": "array", "desde": 2 },
    "fitProfile": { "tipo": "object", "desde": 2 },
    "alpha": { "tipo": "string", "desde": 2, "enum": ["opaque", "mask", "blend"] },
    "pipelineVersion": { "tipo": "string", "desde": 2 },
    "toolVersions": { "tipo": "object", "desde": 2 },
    "look": { "tipo": "string", "desde": 2 }
  },
  "qaVisual": {
    "status": { "tipo": "string", "obrigatorio": true, "enum": ["pending", "approved", "approved_with_notes", "rework", "rejected"] },
    "reviewer": { "tipo": "string" },
    "data": { "tipo": "string" },
    "versao": { "tipo": "string" },
    "notas": { "tipo": "string" },
    "evidencias": { "tipo": "array" }
  },
  "naming": {
    "$comment": "decisão #166 — regex por tipo só para assets NOVOS (schemaVersion ≥ 2); ids v1 publicados ficam como estão",
    "personagem_base": "^(base|humano|androide|animal)_[a-z0-9_]+$",
    "parte_cabelo": "^cab(3d)?_[a-z0-9_]+$",
    "parte_barba": "^(cab|brb3d)_[a-z0-9_]+$",
    "parte_roupa": "^rou3d_[a-z0-9_]+$",
    "parte_acessorio": "^ace3d_[a-z0-9_]+$",
    "cenario": "^cen3d_[a-z0-9_]+$",
    "pet": "^pet3d_[a-z0-9_]+$",
    "companion": "^ace3d_[a-z0-9_]+$",
    "vfx": "^vfx3d_[a-z0-9_]+$"
  }
}
